    </release>
    <release version="0.3.5" date="2026-11-21"/>
    <release version="0.3.4" date="2026-11-19"/>
    <release version="0.3.3" date="2026-11-18"/>
    <release version="0.3.2" date="2026-11-17"/>
    <release version="0.3.1" date="2026-11-17"/>
    <release version="0.3.0" date="2026-11-16"/>
  </releases>
</component>

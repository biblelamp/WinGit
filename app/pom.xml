<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cz.wingit</groupId>
        <artifactId>wingit-parent</artifactId>
        <version>0.4.2-SNAPSHOT</version>
    </parent>

    <artifactId>wingit-app</artifactId>
    <name>WinGit App</name>
    <description>Entry point, settings, wiring, packaging</description>

    <properties>
        <exec.skip>false</exec.skip>

        <!-- jpackage: numeric version only (no -SNAPSHOT); type msi/exe needs WiX 3 on PATH,
             app-image works without it -->
        <jpackage.type>msi</jpackage.type>
        <jpackage.appVersion>0.4.2</jpackage.appVersion>
        <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
        <!-- options file src/jpackage/<argsFile>.args; the linux profile adds a "linux-" prefix -->
        <jpackage.argsFile>${jpackage.type}</jpackage.argsFile>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cz.wingit</groupId>
            <artifactId>wingit-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <!-- version.properties gets the Maven version, also when the IDE runs the app from classes -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <profiles>
        <!-- On Linux: jpackage builds a DEB by default (-Djpackage.type=rpm|app-image for the
             others) and reads its options from src/jpackage/linux-<type>.args -->
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <jpackage.type>deb</jpackage.type>
                <jpackage.argsFile>linux-${jpackage.type}</jpackage.argsFile>
            </properties>
        </profile>
        <!-- mvn -q -pl app -am -Picons -DskipTests package  ->  regenerates src/jpackage/wingit.ico
             from the app icon SVG (run after changing the SVG, then commit the .ico) -->
        <profile>
            <id>icons</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>app-icon</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>-Djava.awt.headless=true</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>src/tools/IconExport.java</argument>
                                        <argument>../ui/src/main/resources/cz/wingit/ui/icons/app/wingit.svg</argument>
                                        <argument>src/jpackage/wingit.ico</argument>
                                        <!-- 256 px PNG: the icon for Linux packages -->
                                        <argument>src/jpackage/wingit.png</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- tiles and logos for the Microsoft Store MSIX package -->
                            <execution>
                                <id>msix-assets</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>-Djava.awt.headless=true</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>src/tools/MsixAssets.java</argument>
                                        <argument>../ui/src/main/resources/cz/wingit/ui/icons/app/wingit.svg</argument>
                                        <argument>../packaging/msstore/Assets</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- mvn -q -pl app -am -Ppackage package  ->  target/installer/ -->
        <profile>
            <id>package</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-libs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <!-- the app jar, plus LICENSE, notices and licenses/ installed next to it -->
                            <execution>
                                <id>jpackage-files</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>${project.basedir}/..</directory>
                                            <includes>
                                                <include>LICENSE</include>
                                                <include>THIRD-PARTY-NOTICES.md</include>
                                                <include>licenses/**</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>${jpackage.type}</argument>
                                        <argument>--name</argument>
                                        <argument>WinGit</argument>
                                        <argument>--app-version</argument>
                                        <argument>${jpackage.appVersion}</argument>
                                        <argument>--vendor</argument>
                                        <argument>WinGit project</argument>
                                        <argument>--description</argument>
                                        <argument>${project.parent.description}</argument>
                                        <argument>--input</argument>
                                        <argument>${jpackage.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${exec.mainClass}</argument>
                                        <!-- options valid only for this type, e.g. the license page -->
                                        <argument>@src/jpackage/${jpackage.argsFile}.args</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
